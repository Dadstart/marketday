# Copy to .env and fill in the client IDs from Google Cloud and Microsoft Entra.
# Restart Expo after changing this file.

# Google Cloud → Credentials → OAuth client ID → Web application
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Cloud → Credentials → OAuth client ID → iOS
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google Cloud → Credentials → OAuth client ID → Android
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Microsoft Entra → App registration → Application (client) ID
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=

# Supabase → Project Settings → API. The service role key stays on the server.
SUPABASE_URL=https://fiwpwhgcyhaujunmcdxw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# API used by the Expo app.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Stripe → Developers → API keys. The live key is used when it is set. Server only.
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=

# Amazon SES. Server only. The From identity must be verified, and the account must be out of the sandbox.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
